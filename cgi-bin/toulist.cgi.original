require "cgi-lib.pl";

MAIN:
{

  # Read in all the variables set by the form
  &ReadParse(*input);

  $partname=lc($input{'partname'});
  $startyear=$input{'startyear'};
  $endyear=$input{'endyear'};
  $state=$input{'state'};



if ($input{'state'} eq'') {$state='all';}

  # Print the header
  print &PrintHeader;

  print <<STOP;
