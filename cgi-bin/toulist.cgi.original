	</div>
</div>
 <TABLE class="table" style="margin-top:10px;">
       <TR class="success"><th></th><th>Tournament</th><th></th><th></th><th></th><th></th><th></th></TR>
STOP
        open(ARCHIVE,"archive.txt") or die;
        $size=<ARCHIVE>;
        for ($a=1;$a<=$size;$a++) {


                                 #open loop for Archive dot text

                                  $toufile=<ARCHIVE>;

                       if($toufile =~ m/.fin/) {} else {

                                 open(TOUFILE,"../$toufile");
                                 $touname=<TOUFILE>; # title
                                 $pairing=substr($touname,0,2);
                                 $touname= substr($touname, 2);

                                 my @parts=split('/',$toufile);

                                 $lowtou=lc($touname);

                                 $flag=1;
                                 $flag=0 if $parts[0]<$startyear;
                                 $flag=0 if $parts[0]>$endyear;
                                 if ($state ne 'all') { $flag=0 if $parts[1] ne $state;}
                                 if($lowtou =~ m/$partname/) {} else {$flag=0;}

if ($flag==1) {
     print "<TR><TD><A HREF='toulist.cgi?state=$parts[1]&startyear=$startyear&endyear=$endyear'><img src='../flags/$parts[1].png' border=0></A></TD><TD><a href='tou.cgi?tou=$toufile'>$touname</a></TD>";

 $filename=substr($toufile, 0, -5);
 $filename="../".$filename.'STS';

    if ($pairing ne "*N") {  print "</TD><TD><a href='tou.cgi?tou=$toufile'>Results</A></TD>";  }
    else { print "</TD><TD></TD>";}


    if (-e $filename) {



print "<TD><A HREF='ratings.cgi?tou=$toufile'>Ratings</A>";
}

else {print "<TD>";}

     if ($pairing ne "*N") {
     print "<TD><A HREF='statistics.cgi?tou=$toufile'>Stats</A></TD>";   }

     else {print "<TD></TD>";}






 $filename=substr($toufile, 0, -5);
 $filename="../".$filename.'fin';


    if (-e $filename) {$filename=substr($filename,3); print "<TD><a href='tou.cgi?tou=$filename'>Finals</a></TD>";}
    else {print "<TD></TD>";}


     
     
     


 $filename=substr($toufile, 0, -5);
 $filename="../".$filename.'STA';


    if (-e $filename) {



print "<TD><A HREF='$filename'>Legacy Ratings</A></TD>";
}

else {print "<TD></TD>";}

     print "</TR>";
     }  # End of loop
     
}     # end of IF



                                 close(TOUFILE);
        }

print "</TABLE>";
      print &HtmlBot;
}

